# Build output
/dist/
/build/
*.test
*.out

# The vendored ripgrep builds are executables that must be committed: the whole
# point of vendoring them is that the archive works on a machine with nothing
# installed. They are re-included below.
tools/vendor/rg/**/rg
tools/vendor/rg/**/rg.exe

# The Python project this was rewritten from: reference material, not source.
/old_code/

# The end-to-end harness's working directory.
/.e2e/

# A Go build cache pointed inside the workspace, for environments where the
# default one (under the user's home) is not writable. It is build output and
# thousands of files, so it must never be staged.
/.tmp-gocache/

# Scratch workspaces used to drive the interface by hand while working on it.
# They are somebody's test session, not part of the program.
/.demo/
/hello/

# Editor / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# Session state, never committed
.tudouni/

# The agent harness's own working notes for this repository. They are a scratchpad
# that happens to live here, and nothing in the program reads them.
/.workbuddy/

# Keep the vendored engines even though they look like build output.
!tools/vendor/rg/x86_64-pc-windows-msvc/rg.exe
!tools/vendor/rg/x86_64-unknown-linux-musl/rg

# The Python project this was rewritten from, kept on disk as reference material.
tudouni-ai/