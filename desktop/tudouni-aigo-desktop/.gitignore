# Build output
node_modules/
dist/
.test-build/
.esbuild-tmp/
.tmp/
.e2e-workspace/
.wv2-data/
.webview-data/
render-check.png

# A WebView2/IME subprocess drops this next to whatever directory the app was
# launched from. It is not our output.
debug.log

# Scratch logs from driving the window by hand while chasing the launch failure
# the README records. Diagnostics from one machine, not part of the program.
launch.log
probe-launch.log

# Rust
src-tauri/target/
src-tauri/gen/

# The staged runtime: an 18 MB binary plus a 4 MB ripgrep, both regenerated by
# `make release`. Committing them would let them drift from VERSION.
# Run `npm run runtime:stage` to populate this directory.
src-tauri/runtime/*
!src-tauri/runtime/README.md

# TypeScript incremental build
*.tsbuildinfo
